{"repo":"math-inc/strongpnt","ref":"2f5835c322314f55f1026ec2f139d704b7c45c69","files":[{"p":"StrongPNT/PNT1_ComplexAnalysis.lean","t":"PNT1 Complex Analysis","s":"","i":[],"l":5839,"n":[324,10,0],"h":[{"k":"theorem","n":"real_log_of_modulus_difference","d":"Lemma: log|B(z)| - log|B(0)| = Re(J(z))."},{"k":"theorem","n":"log_modulus_as_sum","d":"Lemma: log|B(z)| = log|B(0)| + log(exp(Re(J(z))))."},{"k":"theorem","n":"modulus_of_exp_log","d":"Lemma: |B(z)| = |B(0)| * exp(Re(J(z)))."},{"k":"theorem","n":"modulus_of_B_product_form","d":"Lemma: |B(z)| = |B(0)| * |exp(J(z))|."},{"k":"theorem","n":"analytic_log_exists","d":"Lemma: B(z) = B(0) * exp(J(z))."},{"k":"theorem","n":"H_is_constant","d":"Lemma: H is constant on the closed ball."}]},{"p":"StrongPNT/PNT2_LogDerivative.lean","t":"PNT2 Log Derivative","s":"","i":["StrongPNT/PNT1_ComplexAnalysis.lean"],"l":4206,"n":[195,5,0],"h":[{"k":"def","n":"Cf","d":"The “deflated” quotient: divide `f` by the product of `(z-ρ)^{m_ρ}`, and at a zero `z=σ` use the local factor function `h_σ σ` in the numerator (so the expression extends analytically)."}]},{"p":"StrongPNT/PNT3_RiemannZeta.lean","t":"PNT3 Riemann Zeta","s":"","i":["StrongPNT/PNT2_LogDerivative.lean"],"l":4778,"n":[235,4,0],"h":[{"k":"theorem","n":"lem_zetaUppBound","d":"Lemma: Final zeta upper bound with shift."},{"k":"theorem","n":"lem_abs_im_bound","d":"Helper lemma for the final bound."},{"k":"theorem","n":"lem_zfroms_calc","d":"Lemma: `z` from `s` (first version)."},{"k":"theorem","n":"lem_zetaUppBd","d":"Lemma: Upper bound on zeta in the vertical strip."},{"k":"theorem","n":"lem_finalAlgebra","d":"Lemma: Final algebraic simplification."},{"k":"theorem","n":"lem_finalBoundCombination","d":"Lemma: Final bound combination."}]},{"p":"StrongPNT/PNT4_ZeroFreeRegion.lean","t":"PNT4 Zero Free Region","s":"","i":["StrongPNT/PNT3_RiemannZeta.lean","StrongPNT/Z0.lean"],"l":6620,"n":[263,9,0],"h":[{"k":"theorem","n":"lem_sumempty","d":"For any $g:\\C\\to\\C$, if $S=\\emptyset$ then $\\sum_{s\\in S}g(s) = 0$"},{"k":"theorem","n":"lem_absrez1d2","d":"Let $\\delta >0$ and $z\\in \\C$. If $|\\Re(z)-(1-\\delta)| \\le \\delta/2$ then $\\Re(z) \\ge 1-\\frac{3}{2}\\delta$"},{"k":"theorem","n":"lem_absrez1d","d":"Let $\\delta >0$ and $z\\in \\C$. If $|\\Re(z)-(1-\\delta)| \\le \\delta/2$ then $\\Re(z)-(1-\\delta) \\ge -\\delta/2$"},{"k":"theorem","n":"lem_negleabs","d":"Let $a\\in\\R$ and $b>0$. If $|a|\\le b$ then $a\\ge -b$."},{"k":"theorem","n":"Z0boundRe_const3","d":"There exists a constant `C > 0` such that for all `δ > 0`, `Re(-logDerivZeta (1 + δ)) - 1/δ ≤ C`."},{"k":"theorem","n":"Z0boundRe_const2","d":"There exists a constant `C > 0` such that for all `δ > 0`, `Re(-logDerivZeta (1 + δ)) + Re(- 1/δ) ≤ C`."}]},{"p":"StrongPNT/PNT5_Strong.lean","t":"PNT5 Strong","s":"","i":["StrongPNT/ZetaZeroFree.lean"],"l":6599,"n":[52,16,0],"h":[{"k":"theorem","n":"Strong_PNT","d":"*** Prime Number Theorem (Strong_ Strength) *** The `ChebyshevPsi` function is asymptotic to `x`."},{"k":"def","n":"sigma1Of","d":"Our preferred left vertical line."}]},{"p":"StrongPNT/Z0.lean","t":"Z0","s":"","i":["StrongPNT/PNT3_RiemannZeta.lean"],"l":68,"n":[2,0,0],"h":[{"k":"theorem","n":"Z0bound","d":""},{"k":"theorem","n":"Z0bound_aux","d":""}]},{"p":"StrongPNT/ZetaZeroFree.lean","t":"Zeta Zero Free","s":"","i":["StrongPNT/PNT4_ZeroFreeRegion.lean"],"l":292,"n":[6,0,0],"h":[{"k":"theorem","n":"LogDerivZetaHolcLargeT'","d":""},{"k":"theorem","n":"LogDerivZetaHolcSmallT'","d":""}]}]}
